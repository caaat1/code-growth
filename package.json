{
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "Konstantin Golov",
  "bin": {
    "code-growth": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/caaat1/code-growth/issues"
  },
  "description": "Track how a codebase grows: one size snapshot per commit, kept in the repo, with a page of trends.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "find-up": "^8.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/config.json": "./schema/config.json"
  },
  "files": [
    "dist",
    "page",
    "schema"
  ],
  "homepage": "https://github.com/caaat1/code-growth#readme",
  "keywords": [
    "cli",
    "code-metrics",
    "codebase",
    "git-hook",
    "pre-commit",
    "statistics",
    "trends"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "prettier --write",
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "name": "code-growth",
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caaat1/code-growth.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.src.json",
    "build:clean": "npm run dist:clean && npm run build",
    "code-growth": "tsx --tsconfig tsconfig.test.json src/cli.ts",
    "dist:clean": "rimraf dist",
    "format:check": "prettier --check .",
    "hooks": "husky",
    "lint": "eslint --cache --format=stylish --cache-location .eslintcache --no-warn-ignored --max-warnings 0",
    "lint:page": "npm run lint -- ./page",
    "lint:self": "npm run lint -- ./eslint.config.mjs \"./eslint.config/**/*.mjs\"",
    "lint:self:fix": "npm run lint:self -- --fix",
    "lint:src": "npm run lint -- ./src",
    "lint:src:fix": "npm run lint:src -- --fix",
    "lint:src:fix:no-cache": "npm run lint:src:fix -- --no-cache",
    "lint:src:no-cache": "npm run lint:src -- --no-cache",
    "lint:test": "npm run lint -- ./test",
    "lint:test:fix": "npm run lint:test -- --fix",
    "prepare": "npm run build:clean",
    "test": "tsx --tsconfig tsconfig.test.json --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "type-check": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.test.json",
    "validate": "npm run validate:static && npm run test",
    "validate:lint": "npm run lint:src && npm run lint:test && npm run lint:page",
    "validate:lint:fix": "npm run lint:src:fix && npm run lint:test:fix",
    "validate:static": "npm run type-check && npm run validate:lint && npm run format:check && npm run code-growth -- check"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.1"
}
